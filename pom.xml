<?xml version="1.0" encoding="UTF-8"?>
<!--
  CrisisConnect - Intelligent Emergency Resource Coordination System
  UCS553 Enterprise Web Application - Mini Project
  Build tool: Maven (Unit 1 - build tools)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.crisisconnect</groupId>
    <artifactId>crisisconnect</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>CrisisConnect</name>
    <description>Intelligent Emergency Resource Coordination System</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.5</javafx.version>
        <main.class>com.crisisconnect.Launcher</main.class>
    </properties>

    <dependencies>
        <!-- JavaFX (OpenJFX) modules used by the dashboard -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- SQLite JDBC driver (Unit 4 - JDBC) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- Unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- mvn javafx:run  -> launches the desktop dashboard -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.crisisconnect.CrisisConnectApp</mainClass>
                </configuration>
            </plugin>
            <!-- mvn exec:java  -> runs the REST API server only (for the website) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.crisisconnect.api.ApiServerMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
